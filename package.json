{
  "name": "@tenchi4u/pi-recall",
  "version": "0.5.3",
  "description": "Session and prompt history management for Pi coding agent: organize, name, and recall conversations.",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "author": "the-matt-moo",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "pi-recall": "./bin/pi-recall.mjs",
    "pi-session": "./bin/pi-recall.mjs",
    "pi-history": "./bin/pi-recall.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "repository": {
    "type": "git",
